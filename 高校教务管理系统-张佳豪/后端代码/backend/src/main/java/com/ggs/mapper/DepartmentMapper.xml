<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ggs.mapper.DepartmentMapper">

    <resultMap id="deptMap" type="com.ggs.pojo.Department">
        <id property="did" column="did"/>
        <result property="name" column="name"/>
        <result property="dean" column="dean"/>
    </resultMap>

    <select id="listDepartment" resultMap="deptMap">
        SELECT did, name, dean FROM department
    </select>

    <select id="getById" resultMap="deptMap">
        SELECT did, name, dean FROM department WHERE did = #{did}
    </select>

    <insert id="add" useGeneratedKeys="true" keyProperty="did">
        INSERT INTO department (name, dean) VALUES (#{name}, #{dean})
    </insert>

    <update id="update">
        UPDATE department SET name = #{name}, dean = #{dean} WHERE did = #{did}
    </update>

    <delete id="delete">
        DELETE FROM department WHERE did = #{did}
    </delete>

</mapper>
